{
  "doctype": "DocType",
  "name": "Customer Profile",
  "module": "CycleTrack",
  "permissions": [
    {"role": "Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Customer", "read": 1}
  ],
  "fields": [
    {"fieldname": "full_name", "label": "Full Name", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "phone", "label": "Phone", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "email", "label": "Email", "fieldtype": "Data"},
    {"fieldname": "user", "label": "Linked User", "fieldtype": "Link", "options": "User"},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Active\nInactive", "default": "Active"}
  ]
}
